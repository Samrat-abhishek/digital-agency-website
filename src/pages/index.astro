---
import "../styles/global.css";

const services = [
  {
    number: "01",
    title: "Search Engine Optimisation",
    description: "Build long-term visibility with practical SEO work focused on the people searching for what you offer.",
    tags: ["Technical SEO", "Content strategy", "On-page SEO"]
  },
  {
    number: "02",
    title: "Google Ads",
    description: "Reach people with clear intent through structured campaigns, thoughtful targeting and ongoing optimisation.",
    tags: ["Search campaigns", "Shopping campaigns", "Conversion tracking"]
  },
  {
    number: "03",
    title: "Meta Ads",
    description: "Create and improve campaigns across Facebook and Instagram with creative testing and useful measurement.",
    tags: ["Campaign strategy", "Creative testing", "Lead generation"]
  },
  {
    number: "04",
    title: "Website Design",
    description: "Make it easier for visitors to understand your offer, trust your business and take the next step.",
    tags: ["Landing pages", "Business websites", "Conversion-focused design"]
  }
];

const steps = [
  ["01", "Understand", "We learn about your business, audience, offer and what you want to achieve."],
  ["02", "Plan", "We agree on priorities, a realistic plan and how progress will be measured."],
  ["03", "Execute", "We do the work, keep communication clear and share what is happening."],
  ["04", "Improve", "We review performance and make considered changes based on what the data shows."]
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Practical digital marketing for businesses ready to grow. SEO, Google Ads, Meta Ads and website design." />
    <meta name="theme-color" content="#f5f4f0" />
    <title>Your Agency — Digital marketing that makes sense</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Your Agency home">
        <span class="brand-mark">Y.</span>
        <span>YOUR AGENCY</span>
      </a>
      <nav class="desktop-nav" aria-label="Main navigation">
        <a href="#services">Services</a>
        <a href="#about">About</a>
        <a href="#approach">Our approach</a>
      </nav>
      <a class="header-cta" href="#contact">Let’s talk <span aria-hidden="true">↗</span></a>
      <button class="menu-toggle" aria-label="Open menu" aria-expanded="false">☰</button>
    </header>

    <main>
      <section class="hero section-wrap">
        <div class="hero-copy">
          <p class="eyebrow"><span class="eyebrow-dot"></span> DIGITAL MARKETING FOR AMBITIOUS BUSINESSES</p>
          <h1>Good marketing.<br /><span>Clear direction.</span></h1>
          <p class="hero-intro">We help businesses get found, reach the right people and turn more of the right attention into action.</p>
          <div class="hero-actions">
            <a class="button button-dark" href="#contact">Talk about your goals <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#services">Explore what we do <span aria-hidden="true">↓</span></a>
          </div>
          <p class="hero-note">Straightforward thinking. Thoughtful execution. No inflated promises.</p>
        </div>
        <div class="hero-art" aria-label="Abstract editorial illustration">
          <div class="art-topline"><span>STRATEGY / DIGITAL / GROWTH</span><span>01 — 04</span></div>
          <div class="art-orbit orbit-one"></div>
          <div class="art-orbit orbit-two"></div>
          <div class="art-core"><span>MAKE<br />IT<br /><i>MATTER.</i></span></div>
          <div class="art-side-label">BUILT AROUND YOUR BUSINESS</div>
          <div class="art-bottom"><span>LESS NOISE.</span><span>MORE CLARITY.</span></div>
        </div>
      </section>

      <section class="intro-band">
        <div class="section-wrap intro-grid">
          <p class="eyebrow">A PRACTICAL PARTNER</p>
          <p class="intro-statement">Marketing should make sense for your business — not just look good in a report.</p>
          <p class="intro-support">We bring strategy, channel expertise and consistent optimisation together, with a focus on the work that matters to your goals.</p>
        </div>
      </section>

      <section class="services section-wrap" id="services">
        <div class="section-heading">
          <div>
            <p class="eyebrow">WHAT WE DO</p>
            <h2>Focused services.<br /><span>Connected thinking.</span></h2>
          </div>
          <p class="section-side-copy">The right mix depends on your business, your audience and where you want to go. We start there.</p>
        </div>
        <div class="service-list">
          {services.map((service) => (
            <article class="service-row">
              <span class="service-number">{service.number}</span>
              <div class="service-main">
                <h3>{service.title}</h3>
                <p>{service.description}</p>
                <div class="tag-list">
                  {service.tags.map((tag) => <span>{tag}</span>)}
                </div>
              </div>
              <a class="service-arrow" href="#contact" aria-label={`Enquire about ${service.title}`}>↗</a>
            </article>
          ))}
        </div>
      </section>

      <section class="about-section" id="about">
        <div class="section-wrap about-grid">
          <div class="about-heading">
            <p class="eyebrow">WHO WE ARE</p>
            <h2>Good work starts with <span>good understanding.</span></h2>
          </div>
          <div class="about-copy">
            <p class="about-lead">No one-size-fits-all playbook. No confusing jargon. Just considered digital marketing built around the realities of your business.</p>
            <p>We take the time to understand what you offer, who you need to reach and what success means to you. Then we focus on the channels and actions that make sense.</p>
            <a class="underlined-link" href="#contact">Get to know how we work <span>↗</span></a>
          </div>
        </div>
      </section>

      <section class="approach section-wrap" id="approach">
        <div class="section-heading">
          <div>
            <p class="eyebrow">HOW WE WORK</p>
            <h2>A clear process.<br /><span>From day one.</span></h2>
          </div>
          <p class="section-side-copy">You’ll know what we’re doing, why we’re doing it and what comes next.</p>
        </div>
        <div class="process-grid">
          {steps.map(([number, title, description]) => (
            <article class="process-card">
              <span class="process-number">{number}</span>
              <h3>{title}</h3>
              <p>{description}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="honesty-band">
        <div class="section-wrap honesty-inner">
          <p class="eyebrow">A NOTE ON RESULTS</p>
          <h2>Real work. Honest reporting.<br /><span>No overnight-success stories.</span></h2>
          <p>Digital marketing takes testing, consistency and time. We’ll be clear about what we can do, what we’re measuring and what the results tell us.</p>
        </div>
      </section>

      <section class="contact-section section-wrap" id="contact">
        <div class="contact-copy">
          <p class="eyebrow">LET’S START A CONVERSATION</p>
          <h2>Tell us what<br /><span>you’re working on.</span></h2>
          <p>Share a little about your business and what you need help with. We’ll take it from there.</p>
        </div>
        <div class="contact-panel">
          <p class="contact-panel-label">HAVE A PROJECT IN MIND?</p>
          <a class="contact-email" href="mailto:hello@yourdomain.com">hello@yourdomain.com <span>↗</span></a>
          <div class="contact-divider"></div>
          <p class="contact-small">Prefer a quick conversation?</p>
          <a class="button button-light" href="https://wa.me/910000000000" target="_blank" rel="noreferrer">Message us on WhatsApp <span>↗</span></a>
          <p class="contact-placeholder">Update the email address and WhatsApp number before publishing.</p>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="section-wrap footer-top">
        <a class="brand brand-footer" href="/"><span class="brand-mark">Y.</span><span>YOUR AGENCY</span></a>
        <p>Digital marketing, without the noise.</p>
        <a class="back-top" href="#top" onclick="window.scrollTo({top:0,behavior:'smooth'}); return false;">Back to top ↑</a>
      </div>
      <div class="section-wrap footer-bottom">
        <span>© <span id="year"></span> Your Agency. All rights reserved.</span>
        <span>SEO · Paid Media · Website Design</span>
      </div>
    </footer>

    <script>
      const menuButton = document.querySelector(".menu-toggle");
      const nav = document.querySelector(".desktop-nav");
      menuButton?.addEventListener("click", () => {
        const isOpen = nav.classList.toggle("nav-open");
        menuButton.setAttribute("aria-expanded", String(isOpen));
        menuButton.textContent = isOpen ? "×" : "☰";
      });
      nav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => {
        nav.classList.remove("nav-open");
        menuButton?.setAttribute("aria-expanded", "false");
        if (menuButton) menuButton.textContent = "☰";
      }));
      document.querySelector("#year").textContent = new Date().getFullYear();
    </script>
  </body>
</html>
